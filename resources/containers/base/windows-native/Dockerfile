LABEL org.frenchexdev.mutator.module="runtime-base" org.frenchexdev.mutator.platform="windows"
SHELL ["powershell.exe", "-NoLogo", "-NoProfile", "-Command", "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue';"]
RUN Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/PowerShell/PowerShell/releases/download/v7.6.7/PowerShell-7.6.7-win-x64.zip' -OutFile C:/pwsh.zip; if ((Get-FileHash C:/pwsh.zip).Hash -ne 'D2F952EBDBF24386CB8923553AA58E41A846DB35A6155EA04C58142A4B16DBB7') { throw 'PowerShell archive hash mismatch' }; Expand-Archive C:/pwsh.zip 'C:/Program Files/PowerShell/7'; Remove-Item C:/pwsh.zip
ARG TOOL_VERSION
ARG TOOL_URL
ARG TOOL_SHA256
ENV TOOL_VERSION=${TOOL_VERSION} TOOL_URL=${TOOL_URL} TOOL_SHA256=${TOOL_SHA256}
ENV PATH="C:\Program Files\PowerShell\7;C:\ProgramData\chocolatey\bin;C:\Windows\System32;C:\Windows;C:\Windows\System32\WindowsPowerShell\v1.0" PSModulePath="C:\mutator\modules;C:\Program Files\PowerShell\Modules;C:\Program Files\PowerShell\7\Modules;C:\Program Files\WindowsPowerShell\Modules" MUTATOR_MODULE=runtime-base
COPY ["FrenchExDev.Mutator.PoSh/resources/containers/definitions/bootstrap/Initialize-Image.ps1","C:/mutator/bootstrap/Initialize-Image.ps1"]
RUN ["pwsh","-NoLogo","-NoProfile","-File","C:/mutator/bootstrap/Initialize-Image.ps1"]
