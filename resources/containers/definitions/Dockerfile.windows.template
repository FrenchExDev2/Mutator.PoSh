# escape=`
# Generated by Export-MutatorContainerDefinition. Context: PoSh/FrenchExDev.
# Build this image with a Windows container engine, not a Linux Podman machine.
ARG BASE_IMAGE=mcr.microsoft.com/windows/servercore:ltsc2025
FROM ${BASE_IMAGE}
LABEL org.frenchexdev.mutator.module="__MODULE__" org.frenchexdev.mutator.platform="windows"
SHELL ["powershell.exe", "-NoLogo", "-NoProfile", "-Command", "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue';"]
RUN Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/PowerShell/PowerShell/releases/download/v__PWSH_VERSION__/PowerShell-__PWSH_VERSION__-win-x64.zip' -OutFile C:/pwsh.zip; if ((Get-FileHash C:/pwsh.zip).Hash -ne '__PWSH_SHA256__') { throw 'PowerShell archive hash mismatch' }; Expand-Archive C:/pwsh.zip 'C:/Program Files/PowerShell/7'; Remove-Item C:/pwsh.zip
ARG TOOL_VERSION
ARG TOOL_URL
ARG TOOL_SHA256
ENV TOOL_VERSION=${TOOL_VERSION} TOOL_URL=${TOOL_URL} TOOL_SHA256=${TOOL_SHA256}
ENV PATH="C:\Program Files\PowerShell\7;C:\ProgramData\chocolatey\bin;C:\Windows\System32;C:\Windows;C:\Windows\System32\WindowsPowerShell\v1.0" PSModulePath="C:\mutator\modules;C:\Program Files\PowerShell\Modules;C:\Program Files\PowerShell\7\Modules;C:\Program Files\WindowsPowerShell\Modules" MUTATOR_MODULE=__MODULE__
COPY ["FrenchExDev.Mutator.PoSh/resources/containers/definitions/bootstrap/", "C:/mutator/bootstrap/"]
COPY ["__MODULE__/containers/image.json", "C:/mutator/image.json"]
RUN ["pwsh", "-NoLogo", "-NoProfile", "-File", "C:/mutator/bootstrap/Initialize-Image.ps1"]
RUN ["pwsh", "-NoLogo", "-NoProfile", "-File", "C:/mutator/bootstrap/Install-ImageTool.ps1", "-Platform", "Windows", "-Root", "C:/mutator"]
__MODULE_COPIES__
WORKDIR C:/mutator/workload
ENTRYPOINT ["pwsh", "-NoLogo", "-NoProfile", "-File", "C:/mutator/bootstrap/Enter-Image.ps1"]
CMD ["pwsh", "-NoLogo", "-NoProfile"]
